# Tesla official inventory models: my, m3, or both
TESLA_MODELS=my,m3

# Telegram (leave empty to print to the console only)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Search origin — example La Jolla, CA. Set both coordinates for another ZIP.
TESLA_ZIP=92092
TARGET_LAT=
TARGET_LNG=
NEARBY_RADIUS_MILES=50

# Hunt
TESLA_MIN_YEAR=2023
MAX_MILEAGE=75000
WATCH_MAX_PRICE=38000
FOCUS_MAX_PRICE=33000
HW4_MAX_PRICE=32000
BASE_MAX_PRICE=32000
NEAR_MAX_FEE=500

# net_plus_fee  ->  $35,000 (+500 transport)
# total         ->  $35,500 (includes $500 transport)
PRICE_DISPLAY_MODE=net_plus_fee
INCLUDE_TRANSPORT_IN_SORT=false
# Keep unknown-fee cars eligible, with an explicit "unknown" label.
PUSH_UNKNOWN_TRANSPORT=true

TESLA_INTERVAL_MINS=15
TESLA_FAIL_BACKOFF_MINS=60
TESLA_ALL_DELIVERABLE=true
TESLA_SKIP_LOCAL_POOL=true
TESLA_REGION=CA
ALERT_TIERS=favorite,focus,hw4,other
CDP_VISIBLE=false
